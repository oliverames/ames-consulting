{
  "name": "ames-consulting-site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:site": "node scripts/generate-public-site.mjs && node scripts/build-site.mjs",
    "generate:public-site": "node scripts/generate-public-site.mjs",
    "check:js-syntax": "node scripts/check-js-syntax.mjs",
    "lint:js": "eslint --max-warnings 0 'assets/js/*.js' 'scripts/*.mjs' 'tests/*.js'",
    "check:html": "html-validate index.html 404.html about/index.html contact/index.html work/index.html work/eastrise/index.html work/blue-cross-vermont/index.html",
    "check:structured-data": "node scripts/validate-structured-data.mjs",
    "check:all": "npm run check:js-syntax && npm run lint:js && npm run check:html && npm run check:structured-data",
    "test:regression": "playwright test tests/site.spec.js",
    "test:a11y": "playwright test tests/accessibility.spec.js",
    "test:e2e": "playwright test",
    "generate:seo-artifacts": "node scripts/generate-seo-artifacts.mjs",
    "generate:ai-summaries": "node scripts/generate-ai-summaries.mjs",
    "generate:blog-posts": "node scripts/generate-blog-posts.mjs",
    "generate:blog-index": "node scripts/generate-blog-index.mjs",
    "generate:photography": "node scripts/generate-photography-galleries.mjs",
    "generate:financial-wellness": "node scripts/generate-financial-wellness-pages.mjs",
    "generate:eastrise": "node scripts/generate-eastrise-pages.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^8.57.1",
    "html-validate": "^9.7.1",
    "xml2js": "^0.6.2"
  }
}
